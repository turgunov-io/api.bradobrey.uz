PORT=4000

# PostgreSQL
# Preferred single connection string for your server database.
DATABASE_URL=postgres://user:password@127.0.0.1:5432/bradobrey
# Or use PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD instead.
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=bradobrey
# PGUSER=bradobrey
# PGPASSWORD=
# POSTGRES_SSL=false

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=12h

# CORS
CORS_ORIGIN=http://localhost:4000,http://localhost:3000

# Cashback (loyalty)
# Set to 0 (or leave empty) to disable.
# Example: 5 means 5% cashback from each completed order (except certificate payments).
CASHBACK_PERCENT=5

# Marketplace profile avatars (optional)
# DEFAULT_AVATAR_URL_TEMPLATE=https://api.dicebear.com/7.x/identicon/svg?seed={seed}

# Uploaded files
# UPLOAD_DIR=public/uploads
# PUBLIC_BASE_URL=https://api.bradobrey.uz

# Marketplace OTP debug (optional; dev only)
# OTP_DEBUG_RETURN_CODE=true

# SMTP (optional; for marketplace OTP emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
