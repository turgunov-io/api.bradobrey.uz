# Runtime
PORT=4000
NODE_ENV=production
# Process timezone; also the fallback for QUEUE_AUTO_CLOSE_TIMEZONE.
TZ=Asia/Tashkent

# PostgreSQL (REQUIRED: one connection method; the API refuses to start without it)
# Resolution order: DATABASE_URL > POSTGRES_URL > POSTGRES_CONNECTION_STRING,
# then discrete PG* vars (POSTGRES_* names are accepted as aliases).
DATABASE_URL=postgres://user:password@127.0.0.1:5432/bradobrey
# POSTGRES_URL=
# POSTGRES_CONNECTION_STRING=
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=bradobrey
# PGUSER=bradobrey
# PGPASSWORD=
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_DB=bradobrey
# POSTGRES_USER=bradobrey
# POSTGRES_PASSWORD=
# TLS: POSTGRES_SSL (or PGSSLMODE) = 1|true|yes|require enables SSL.
# POSTGRES_SSL=false
# PGSSLMODE=
# POSTGRES_SSL_REJECT_UNAUTHORIZED=true
# Pool tuning (defaults shown).
# POSTGRES_POOL_MAX=10
# POSTGRES_IDLE_TIMEOUT_MS=30000
# POSTGRES_CONNECTION_TIMEOUT_MS=10000

# Auth (JWT_SECRET is REQUIRED; use at least 32 random characters)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h

# Telegram Bot API (server-side only; never expose to Flutter/mobile).
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_BOT_USERNAME=replace-with-bot-username
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
# Recommended in production; falls back to JWT_SECRET when unset.
OTP_HASH_SECRET=replace-with-a-long-random-otp-secret

# CORS
CORS_ORIGIN=http://localhost:4000,http://localhost:3000

# Security headers: HSTS is sent when NODE_ENV=production unless this is true.
# DISABLE_HSTS=false

# Cashback (loyalty)
# Set to 0 (or leave empty) to disable.
# Example: 5 means 5% cashback from each completed order (except certificate payments).
CASHBACK_PERCENT=5
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bradobrey.uz

# Marketplace profile avatars (optional)
# DEFAULT_AVATAR_URL_TEMPLATE=https://api.dicebear.com/7.x/identicon/svg?seed={seed}

# Uploaded files
# UPLOAD_DIR=public/uploads
# Public base URL for uploaded file links; first non-empty wins:
# PUBLIC_BASE_URL > API_PUBLIC_URL > APP_PUBLIC_URL, else the request host.
# PUBLIC_BASE_URL=https://api.bradobrey.uz
# API_PUBLIC_URL=
# APP_PUBLIC_URL=

# Queue jobs (defaults shown)
# QUEUE_AUTO_CLOSE_ENABLED=true
# QUEUE_AUTO_CLOSE_ON_STARTUP=true
# QUEUE_AUTO_CLOSE_TIMEZONE=Asia/Tashkent
# QUEUE_TRANSFER_TIMEOUT_MINUTES=10

# Marketplace OTP debug (optional; dev only)
# OTP_DEBUG_RETURN_CODE=false

# SMTP (optional; for marketplace OTP emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Marketplace push provider (optional webhook adapter for FCM/APNs)
MARKETPLACE_PUSH_WEBHOOK_URL=
MARKETPLACE_PUSH_WEBHOOK_TOKEN=
MARKETPLACE_PUSH_POLL_MS=15000

# Native mobile push via Firebase Cloud Messaging (recommended).
# Put the one-line JSON service-account key here with escaped newlines in
# private_key, or inject it as a secret in production. Never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=
CASHBACK_RECONCILIATION_INTERVAL_MS=3600000
REFERRAL_BONUS_POLL_MS=300000
# Behind nginx set true (= 1 hop), a hop count, or a comma list of trusted
# proxy addresses (e.g. loopback,<dashboard server IP>) so req.ip and IP-based
# rate limits see the real client. The list form also honours the client IP the
# dashboard BFF forwards. Required in production behind a proxy.
TRUST_PROXY=false
# Recommended in production; kiosk socket tickets return 503 when unset.
KIOSK_SOCKET_SECRET=replace-with-a-random-32-byte-secret
# Kiosk HTTP auth: kiosks send their registration device token as the
# X-Kiosk-Token header. false (default) = requests without it still work
# (warned); true = kiosk data routes require it (or a staff/marketplace JWT).
KIOSK_AUTH_ENFORCE=false
# Shared secret kiosks send as enrollment_code to POST /api/kiosk/register.
# Empty = registration stays open (warned). Staff JWTs in scope bypass it.
KIOSK_ENROLLMENT_CODE=
